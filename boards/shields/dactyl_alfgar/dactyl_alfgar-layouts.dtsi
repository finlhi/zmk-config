// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        // Edit this to define the positions and sizes of the keys, or remove it
        // if your keyboard will not support ZMK Studio.
        // https://zmk.dev/docs/development/hardware-integration/physical-layouts#optional-keys-propert


        // Define the physical positions for the 64 logical keys (MX1..MX64)
        // Coordinates are in arbitrary units suitable for ZMK Studio display.
        // The layout follows the default_transform's MX numbering (row-major across
        // 12 columns for the main four rows, then the thumb cluster positions).
        keys  //                 w   h    x    y     rot    rx    ry
            =
            // Row 0: MX1..MX12 
			<&key_physical_attrs 90 90 0 0 0 0 0>,
			<&key_physical_attrs 90 90 95 0 0 0 0>,
			<&key_physical_attrs 90 90 190 0 0 0 0>,
			<&key_physical_attrs 90 90 285 0 0 0 0>,
			<&key_physical_attrs 90 90 380 0 0 0 0>,
			<&key_physical_attrs 90 90 475 0 0 0 0>,
			<&key_physical_attrs 90 90 1000 0 0 0 0>,
			<&key_physical_attrs 90 90 1095 0 0 0 0>,
			<&key_physical_attrs 90 90 1190 0 0 0 0>,
			<&key_physical_attrs 90 90 1285 0 0 0 0>,
			<&key_physical_attrs 90 90 1380 0 0 0 0>,
			<&key_physical_attrs 90 90 1475 0 0 0 0>,

            // Row 1: MX13..MX24 
			<&key_physical_attrs 90 90 0 95 0 0 0>,
			<&key_physical_attrs 90 90 95 95 0 0 0>,
			<&key_physical_attrs 90 90 190 95 0 0 0>,
			<&key_physical_attrs 90 90 285 95 0 0 0>,
			<&key_physical_attrs 90 90 380 95 0 0 0>,
			<&key_physical_attrs 90 90 475 95 0 0 0>,
			<&key_physical_attrs 90 90 1000 95 0 0 0>,
			<&key_physical_attrs 90 90 1095 95 0 0 0>,
			<&key_physical_attrs 90 90 1190 95 0 0 0>,
			<&key_physical_attrs 90 90 1285 95 0 0 0>,
			<&key_physical_attrs 90 90 1380 95 0 0 0>,
			<&key_physical_attrs 90 90 1475 95 0 0 0>,


            // Row 2: MX25..MX36 
			<&key_physical_attrs 90 90 0 190 0 0 0>,
			<&key_physical_attrs 90 90 95 190 0 0 0>,
			<&key_physical_attrs 90 90 190 190 0 0 0>,
			<&key_physical_attrs 90 90 285 190 0 0 0>,
			<&key_physical_attrs 90 90 380 190 0 0 0>,
			<&key_physical_attrs 90 90 475 190 0 0 0>,
			<&key_physical_attrs 90 90 1000 190 0 0 0>,
			<&key_physical_attrs 90 90 1095 190 0 0 0>,
			<&key_physical_attrs 90 90 1190 190 0 0 0>,
			<&key_physical_attrs 90 90 1285 190 0 0 0>,
			<&key_physical_attrs 90 90 1380 190 0 0 0>,
			<&key_physical_attrs 90 90 1475 190 0 0 0>,


            // Row 3: MX37..MX48 
			<&key_physical_attrs 90 90 0 285 0 0 0>,
			<&key_physical_attrs 90 90 95 285 0 0 0>,
			<&key_physical_attrs 90 90 190 285 0 0 0>,
			<&key_physical_attrs 90 90 285 285 0 0 0>,
			<&key_physical_attrs 90 90 380 285 0 0 0>,
			<&key_physical_attrs 90 90 475 285 0 0 0>,
			<&key_physical_attrs 90 90 1000 285 0 0 0>,
			<&key_physical_attrs 90 90 1095 285 0 0 0>,
			<&key_physical_attrs 90 90 1190 285 0 0 0>,
			<&key_physical_attrs 90 90 1285 285 0 0 0>,
			<&key_physical_attrs 90 90 1380 285 0 0 0>,
			<&key_physical_attrs 90 90 1475 285 0 0 0>,

            // Row 4: MX49..MX52 
			<&key_physical_attrs 90 90 190 380 0 0 0>,
			<&key_physical_attrs 90 90 285 380 0 0 0>,
			<&key_physical_attrs 90 90 1285 380 0 0 0>,
			<&key_physical_attrs 90 90 1190 380 0 0 0>,


            // Thumb cluster (MX53..MX64)
			<&key_physical_attrs 113 90 360 480 -1500 416 525>,
			<&key_physical_attrs 113 90 455 445 -1500 511 490>,
			<&key_physical_attrs 113 90 960 445 1500 1016 490>,
			<&key_physical_attrs 113 90 1055 480 1500 1111 525>,
			<&key_physical_attrs 90 90 410 545 -1500 455 590>,
			<&key_physical_attrs 90 90 505 515 -1500 550 560>,
			<&key_physical_attrs 90 90 1015 515 1500 1060 560>,
			<&key_physical_attrs 90 90 920 545 1500 965 590>,
			<&key_physical_attrs 90 90 455 615 -1500 500 660>,
			<&key_physical_attrs 90 90 365 585 -1500 410 630>,
			<&key_physical_attrs 90 90 960 585 1500 1005 630>,
			<&key_physical_attrs 90 90 1050 615 1500 1095 660>,
            ;
    };
};
